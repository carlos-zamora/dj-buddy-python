# Copy this file to .env and fill in what you need. .env is git-ignored; never commit it.
# Every value is optional: the defaults run the app and tests with no library and no API key.

# SQLAlchemy database URL. SQLite until Phase 3, then Postgres.
DJBUDDY_DATABASE_URL=sqlite:///./djbuddy.db

# Path to your Rekordbox XML export (File > Export Collection in xml format).
# DJBUDDY_LIBRARY_PATH=C:/Users/you/Music/rekordbox.xml

# Assistant model as a Pydantic AI model string. "test" is the offline test model.
DJBUDDY_MODEL_NAME=test

# API key for the model provider. Only needed for live runs.
# DJBUDDY_LLM_API_KEY=
